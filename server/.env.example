# Example Environment Configuration
# Copy this file and rename to .env.local, .env.staging, or .env.production
# Fill in the actual values for your environment

# Server Configuration
PORT=3003
NODE_ENV=development

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=http://localhost:55321
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Secret (generate a random string)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here

# Default System Admin Account (optional)
DEFAULT_ADMIN_EMAIL=admin@integrityhvac.com
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_NAME=System Administrator

# For Railway/Cloud Deployment:
# Set these as environment variables in your Railway project dashboard
# Do NOT commit .env files with real credentials to git
